{
  "name": "fuel-ios",
  "private": true,
  "version": "1.0.0",
  "description": "Capacitor iOS wrapper for the Fuel web app. The web app itself is app/ and needs none of this to run.",
  "scripts": {
    "test": "node --test app/tests/*.mjs",
    "build:web": "node scripts/build-ios-web.mjs",
    "sync:ios": "npm run build:web && cap sync ios",
    "open:ios": "cap open ios"
  },
  "dependencies": {
    "@capacitor/core": "^8.6.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3",
    "@revenuecat/purchases-capacitor": "^15.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.3"
  }
}
